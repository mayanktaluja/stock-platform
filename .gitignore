# Secrets / environment
.env
.env.local
.env.*.local
.vercel

# Dependencies
node_modules/

# Local runtime state (rebuilt on restart / ephemeral on Vercel)
.sentiment-cache.json
.sentiment-cache-*.tmp
.paper-trades.json
.fii-dii-history.json
.watchlist.json
.openai-budget.json
.openai-budget.json.*.tmp
# Atomic-write temp files from services/macroRegimeStorage.js — the JSON
# itself lives at data/macroRegime.json and IS committed (so Vercel cold
# starts read the last good classification even when KV is unset).
data/macroRegime.json.*.tmp

# Per-run sanity reports — track only _latest.json for ops visibility,
# the timestamped per-run reports balloon and aren't worth committing.
data/sws/_sanity/*
!data/sws/_sanity/_latest.json

# User data — contains real portfolio holdings
portfolio.json

# User accounts (dev-only file fallback for userStorage.js;
# production reads/writes Vercel KV)
users.json

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local state (worktrees + scheduled-task locks). These appear
# untracked in main and would otherwise collide with incoming commits and
# block the nightly's `git pull --ff-only`.
.claude/scheduled_tasks.lock
.claude/worktrees/
.macro-regime-cache.json

# Per-worktree mutable launch config. Tracking this file is the root cause
# of recurring `.claude/launch.json` merge conflicts that brick sws-nightly's
# `git stash push` and silently stale data/macroRegime.json (see PRs #183,
# #188, #201, #205, #221 + the 2026-05-17 incident). Each worktree maintains
# its own local copy; use .claude/launch.example.json as a template.
.claude/launch.json

# Logs + temp output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
reports/
.e2e/
# Added by code-review-graph
.code-review-graph/

# Ad-hoc shadow-mode diagnostics (one-off V2 comparison artifacts, not
# source-of-truth — they're regenerable via scripts/shadow-compare.mjs)
shadow-diff.json
shadow-diff-*.json
data/sws/combined-shadow-diff.json

# P2.1: scanner audit trail — locally-generated each scan; production should
# persist to KV / S3 / equivalent for SEBI 5-yr retention.
data/audit/

# Scratch/test scripts at repo root (kept local, not shipped). Anchored to
# repo root so legitimate fixtures like services/swsDal/test-fixtures.js
# aren't swept up.
/test-*.mjs
/test-*.js

# Ad-hoc personal notes / overnight build summaries (kept local, not shipped)
MORNING_SUMMARY_*.md

# SWS Playwright driver — single browser profile + transient pipeline state
.sws-profile/
.sws-profile-*/
data/sws/captures/
data/sws/active-shards.lock
data/sws/active-shards.lock.tmp.*
data/sws/pipeline.lock
data/sws/pipeline-status.json
data/sws/pipeline-status.json.tmp.*
data/sws/playwright-comparison/
data/sws/progress-*.json
data/sws/scan-*.lock
data/sws/refresh*.log
data/sws/scrape-universe-progress.json
data/sws/universe.json.pre-sitemap-backup
data/sws/universe-from-sitemap.json
data/sws/universe-sitemap-dropped.json
data/sws/universe_scraped.json
data/sws/refresh-requested.json
data/sws/panic-stop.flag
data/sws/picks-latest.json.tmp.*

# Locally-generated transient SWS files — produced during daytime
# interactive/dashboard runs (sws-news-scrape, sws-stamp-section-status)
# but never committed by the nightly. Without these ignores, an incoming
# commit that introduces a tracked file at the same path collides with
# the local untracked file and aborts `git pull --ff-only`.
data/sws/news-latest.json
data/sws/news-progress.json
data/sws/picks-previous.json
data/sws/_aux-refresh-status.tmp

# SWS API pipeline — runtime caches, raw payloads, research captures
data/sws/.jwt-cache.json
data/sws/api-research/
data/sws/api-debug/
data/sws/api-queries.json
data/sws/deep-api/
data/sws/deep-api-parsed/
data/sws/deep.scraper-backup/

# Coverage gap analysis — sitemap cache is ~530 MB of static SWS XML,
# regenerable via scripts/sws-probe-availability.mjs --refresh.
data/coverage/sws-sitemap-cache/

# F&O OI screener — runtime files (locks/logs/raw bhavcopy not committed).
# oi-deltas-latest.json + history/ ARE committed as Vercel boot seed.
data/nse-fo/pipeline.lock
data/nse-fo/refresh.log
data/nse-fo/oi-deltas-latest.json.tmp.*
data/nse-fo/bhavcopy/

portfolios.json
analyzer-last.json
portfolio-history.json
recommendation-ledger.json

# Telemetry NDJSON log (local dev only; Vercel disables the writer)
data/telemetry/

# Earnings refresh concurrency lockfile + cache backups (local dev only).
# .locks/ is the runtime guard so an ad-hoc `node scripts/refresh-earnings.mjs`
# can't race the nightly launchd run; .backups/ holds timestamped copies of
# llm-signal-cache.json snapshotted by --purge-heuristic-cache.
data/.locks/
data/.backups/
# Playwright e2e artefacts
playwright-report/
test-results/
test/e2e/fixtures/groww-sample.xlsx
test/e2e/fixtures/groww-sample-with-summary.xlsx
