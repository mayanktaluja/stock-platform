# Copy this file to .env and fill in your real API key.
# Never commit the real .env — it's in .gitignore.

# OpenAI API key — powers both news sentiment (sentiment.js) and the macro
# regime classifier (macroRegime.js). Same key format used by the Poker Hand
# Reviewer tool — a single key works across both projects.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional: override the OpenAI model used for macro regime classification.
# Defaults to gpt-5.4.
# MACRO_MODEL=gpt-5.4

# SEBI registration number — shown in the Market Intelligence compliance
# footer. Use INH000XXXXXX (Research Analyst, RA Reg 2014) or
# INA000XXXXXX (Investment Adviser, IA Reg 2013). Falls back to
# "Pending registration" when unset.
# SEBI_REG_NO=INH000XXXXXX

# ── Login gate ──
# When BOTH are set, the entire UI + API (except /api/cron/*) is locked
# behind a single password. When either is unset (local dev), the gate
# is a no-op. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STARBHAI_LOGIN_PASSWORD=pick-a-strong-passphrase
# STARBHAI_SESSION_SECRET=64-char-hex-from-the-command-above
