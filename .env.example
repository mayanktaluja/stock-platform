# Copy this file to .env and fill in your real API key.
# Never commit the real .env — it's in .gitignore.

# Groq API key — powers the macro regime classifier (macroRegime.js).
# Free tier: 14,400 req/day. Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_ME

# OpenAI API key — powers news sentiment (sentiment.js).
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional: override the Groq model used for macro regime classification.
# Defaults to llama-3.3-70b-versatile.
# MACRO_MODEL=llama-3.3-70b-versatile

# Optional: Gemini API key — secondary free LLM for macroRegime.js, used
# when Groq is throttled. Free tier covers gemini-2.5-flash on the
# OpenAI-compatible endpoint. Get yours at:
# https://aistudio.google.com/app/apikey
# Note: gemini-2.0-flash is no longer on the free tier (limit: 0) for
# new keys — use 2.5-flash or 2.5-flash-lite.
# GEMINI_API_KEY=REPLACE_ME

# Optional: override the Gemini model used for macro regime classification.
# Defaults to gemini-2.5-flash.
# MACRO_GEMINI_MODEL=gemini-2.5-flash

# ── Auth gate (Google OAuth) ──
# When STARBHAI_SESSION_SECRET, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# are all set, the entire UI + API (except /api/cron/* and the auth
# endpoints) is locked behind "Continue with Google". When any of them
# is unset (local dev), the gate is a no-op so the app still boots.
#
# Set up the OAuth client at https://console.cloud.google.com:
#   1. Create project, enable APIs & Services → OAuth consent screen.
#   2. Credentials → Create OAuth client ID → Web application.
#   3. Authorized redirect URIs:
#        http://localhost:3000/api/auth/google/callback
#        https://starbhai-stock-platform.vercel.app/api/auth/google/callback
#   4. Scopes: openid, userinfo.email, userinfo.profile.
# Generate the session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STARBHAI_SESSION_SECRET signs the userId+ts session cookie and the
# short-lived OAuth state cookie used during the redirect dance.
# STARBHAI_SESSION_SECRET=64-char-hex-from-the-command-above
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_OAUTH_REDIRECT_URI=https://starbhai-stock-platform.vercel.app/api/auth/google/callback
# Comma-separated list of admin emails. Marked with isAdmin=true on every
# login, lookup is case-insensitive. Toggling this takes effect on next
# login (no backfill needed).
# ADMIN_EMAILS=mtaluja11@gmail.com

# ── SWS Portfolio input-change email alerts ──
# User sends require SWS_INPUT_ALERTS_ENABLED=1 and an uploaded Analyzer/
# Portfolio holding set with material SWS input changes. Users are
# email-enabled by default and can opt out from Portfolio Analyzer.
# The sample endpoint also requires SWS_INPUT_ALERT_SAMPLE_SEND=1 and only
# sends to mtaluja11@gmail.com.
#
# Provider defaults to Resend. Resend bulk sends require a verified owned
# sender domain; onboarding@resend.dev is test-only and blocked for live cron.
# RESEND_API_KEY=re_REPLACE_ME
# SWS_MAIL_FROM=Starbhai <alerts@your-verified-domain.example>
#
# Free low-volume fallback: Gmail API. Generate GMAIL_REFRESH_TOKEN with:
#   node scripts/gmail-oauth-local.mjs --env-file=.env.local
# Then set SWS_MAIL_PROVIDER=gmail and keep secrets in Vercel env / .env.local.
# SWS_MAIL_PROVIDER=gmail
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-...
# GMAIL_REFRESH_TOKEN=...
# GMAIL_MAIL_FROM=Starbhai <mtaluja11@gmail.com>
# SWS_INPUT_ALERT_GMAIL_DELAY_MS=750
# SWS_INPUT_ALERT_SAMPLE_SEND=1
# SWS_INPUT_ALERTS_ENABLED=1
# SWS_INPUT_ALERTS_DRY_RUN=0
# SWS_INPUT_ALERTS_SUPPRESS_EMAILS=

# --- Telegram market-moving-news alerts (fast-news-alerts) ---------------
# Personal Telegram bot for instant macro-regime / watchlist-news alerts.
# Setup: DM @BotFather → /newbot → copy the token below. Then message your
# new bot once and read your chat id from:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates" | jq '.result[].message.chat.id'
# When either var is unset every alert path self-skips silently (logs a
# reason, never throws) — the macro cron keeps running normally.
# TG_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# TG_CHAT_ID=99999999
# ALERTS_ENABLED=1          # set 0 to hard-disable all alerts (kill switch)

# --- Market Wire (Telegram firehose → Market Intelligence tab) -----------
# The local builder cron publishes the ranked feed to Vercel KV; prod reads it.
# Pull these two from the Vercel project (they already exist there):
#   vercel env pull /tmp/x --environment=development && grep '^KV_REST_API_' /tmp/x
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# LLM funnel. Chain is Gemini → Groq → deterministic heuristic and NEVER throws,
# so a missing key or an exhausted quota degrades quality, never availability.
# WIRE_LLM_GEMINI_MODEL=gemini-2.5-flash   # flash-lite has ~4x the free RPD, lower quality
# WIRE_LLM_MODEL=openai/gpt-oss-120b       # Groq. llama-3.3-70b-versatile dies 2026-08-16.
#
# Requests/day is the cap that binds on the Gemini free tier (Google removed the
# published RPD table on 2025-12-06; the live number is auth-gated). The cron fires
# ~228x/day, and chunk=18 makes that ONE request per build. Throttle without a
# deploy by lowering the chunk (more requests) or raising the plist StartInterval.
# WIRE_MAX_LLM_CLUSTERS=18   # clusters LLM-refined per build (hard spend cap)
# WIRE_LLM_CHUNK_SIZE=18     # clusters per API request; ceil(MAX/CHUNK) = req/build
# WIRE_LLM_CONCURRENCY=2

# --- Telegram alert de-noise ---------------------------------------------
# Loudness = macro-keyword SEVERITY tier x prose intensity. A watchlist ticker and
# any HIGH-severity event (war / crash / rate decision) are always loud.
# ALERTS_LOUD_MED_MIN=5     # fed / rbi / tariff / cpi need this prose intensity
# ALERTS_LOUD_LOW_MIN=7     # trump / nifty / sensex need this much
