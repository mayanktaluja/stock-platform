# Local-only state files — must NOT be uploaded to Vercel deployments.
# Vercel's serverless filesystem is ephemeral so writing to these would be
# pointless on production anyway, but bundling stale local copies into the
# deploy is worse: it ships outdated data to every cold start.
.sentiment-cache.json
.paper-trades.json
.env
.env.local

# SWS deep briefs are committed as thousands of loose local working files, but
# prod serves them from the packed deep*.tar.gz artifacts via lazy extraction.
data/sws/deep/**
data/sws-us/deep/**
data/sws-kr/deep/**
data/sws-tw/deep/**
data/sws*/deep-api/**
data/sws*/deep-parsed/**
data/sws/chronos-ohlcv-cache/**
data/sws/chronos-model-cache/**
data/sws/chronos-debug/**
**/__pycache__/**
**/*.pyc

# Local generator caches. Prod consumes the aggregate snapshots/tarballs or
# KV-restored state instead of these rolling working sets.
data/sws/groww-stock-latest.json

# The nightly input-diff builder's working set (scripts/sws-build-input-diff.mjs).
# Both are inputs to the LOCAL diff, never read by the function: prod reads only
# the diff's OUTPUT, data/sws/alerts/fundamental-changes-latest.json, and the
# two_consecutive_full_runs verdict is baked into that artifact as a scalar.
# The per-run email dedup is Upstash-KV-backed, not disk-backed, so neither file
# participates in the anti-spam guarantee. Together they were 21.2 MB of the
# function bundle.
data/sws/alerts/input-signatures-latest.json
data/sws/alerts/input-alert-confirmation-state.json

# Hash cache for the LOCAL scripts/refresh-earnings.mjs LLM step. The signal it
# caches is already serialised inline into earnings-watch-latest.json, which is
# what the /api/earnings/* routes read.
data/catalysts/llm-signal-cache.json

# Per-day prediction snapshots (~5 MB/day, 260 MB and climbing). Prod reads them
# from the sibling earnings-history.tar.br via lazy /tmp extraction — see
# services/earnings/earningsHistoryStore.js. The loose files stay in git for the
# local backtest / weight-tuning / actuals-resolution scripts.
data/catalysts/earnings-history/**
# The gzip archive the .tar.br replaced (21.1 MB on 2026-10-27). Nothing reads it;
# scripts/pack-earnings-history.sh deletes it, and this keeps a stale copy (e.g.
# one re-committed by a nightly that started before the switch) out of the bundle.
data/catalysts/earnings-history.tar.gz

# Coverage-audit working files, written and read only by local scripts
# (coverage-gap-analysis.mjs, sws-probe-availability.mjs, sws-build-delta.mjs);
# sws-nightly.sh already restores four of them as "non-deployable generated
# working sets". The only data/coverage file the function reads is
# bse_equity_active.json (services/swsTierGate.js), which stays bundled. These
# were 4.5 MB of the bundle.
data/coverage/coverage_gap.json
data/coverage/coverage_report.md
data/coverage/ground_truth.json
data/coverage/groww_missing_candidates.json
data/coverage/nse_equity_l.csv
data/coverage/nse_sme_emerge.json
data/coverage/sws_availability_probe.json
data/coverage/sws_unavailable.json
data/coverage/sws_universe_delta.json
data/sectorOutlook/classified-news/**
data/sectorOutlook/llm-theme-cache.json
data/nse-fo/history/**
data/risk-lab/llm-disagreement-cache.json
data/strategy/history/**
data/strategy/decisions.ndjson
