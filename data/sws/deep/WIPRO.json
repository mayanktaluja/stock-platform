    {
      "id": "ddec3f14-722a-4b60-9fc6-8b5509977a2f",
      "type": "brief",
      "date": "2026-04-17T11:51:08.000Z",
      "title": "Full year 2026 earnings: EPS misses analyst expectations",
      "body": "Full year 2026 results: EPS: ₹12.60 (up from ₹12.56 in FY 2025). Revenue: ₹926.2b (up 4.0% from FY 2025). Net income: ₹132.0b (flat on FY 2025). Profit margin: 14% (in line with FY 2025). Revenue was in line with analyst estimates. Earnings per share (EPS) missed analyst estimates by 1.0%. Revenue is forecast to grow 4.4% p.a. on average during the next 3 years, compared to a 6.6% growth forecast for the IT industry in India. Over the last 3 years on average, earnings per share has increased by 8% per year whereas the company’s share price has increased by 4% per year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "68be345f-1382-45e3-8e83-ddfa161157b3",
      "type": "event",
      "date": "2026-04-16T10:57:00.000Z",
      "title": "Wipro Limited (BSE:507685) announces an Equity Buyback for 600,000,000 shares, representing 5.72% for INR 150,000 million.",
      "body": "Wipro Limited (BSE:507685) announces a share repurchase program. Under the program, the company will repurchase up to 60,00,00,000 equity shares, representing 5.72% of its issued shares for INR 150,000 million. The shares will be repurchased at a price of INR 250 per share. The purpose of the offer is to return surplus funds to the shareholders thereby enhancing the overall return to the shareholders, to improve financial ratios like return on equity and earnings per share and to provide an option to the shareholders to either participate in the buyback and get cash in lieu of their shares or not participate in the buyback and enjoy an increase in their percentage shareholding post the buyback, without additional investment. The shares repurchased will be funded from current balances of ca",
      "keyDevTypeId": "232",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "0d205884-edb4-4e85-970a-4b8e57a994c2",
      "type": "event",
      "date": "2026-04-15T00:00:00.000Z",
      "title": "Wipro Limited (BSE:507685) signed a definitive agreement to acquire Select Customer Contracts of Alpha Net Consulting, LLC for $70.8 million.",
      "body": "Wipro Limited (BSE:507685) signed a definitive agreement to acquire Select Customer Contracts from Alpha Net Consulting, LLC for $70.8 million on April 14, 2026. A cash consideration of $70.8 million will be paid by Wipro Limited. As part of consideration, $70.8 million is paid towards assets of Select Customer Contracts of Alpha Net Consulting, LLC. The purchase consideration includes a deferred consideration in the form of earnout, payable subject to achievement of certain performance metrics / conditions.\r\n\r\nFor the calendar year ending December 31, 2025, Select Customer Contracts of Alpha Net Consulting, LLC reported total revenue of $37.3 million.\r\n\r\nThe transaction is expected to be completed by June 30, 2026.\r\n\r\nChuck Samuelson, Irina Dolinskiy, Alan Kravitz, Anders Seah, Sean Reill",
      "keyDevTypeId": "80",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
