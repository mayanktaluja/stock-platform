    {
      "id": "3ccf2694-5160-4d21-9228-1cb0c8b8ed2f",
      "type": "narrative-update",
      "date": "2026-02-08T12:05:46.000Z",
      "title": "TIIL: Upcoming Board Results Will Confirm Steady Assumptions Behind Undervalued Earnings Power",
