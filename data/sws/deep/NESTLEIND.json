    {
      "id": "e15b2f9e-a0c1-4295-87a0-76306c5c7dd7",
      "type": "brief",
      "date": "2026-04-23T12:08:18.000Z",
      "title": "Final dividend of ₹5.00 announced",
      "body": "Shareholders will receive a dividend of ₹5.00. Ex-date: 10th July 2026 Payment date: 2nd August 2026 Dividend yield will be 0.9%, which is about the same as the industry average. Sustainability & Growth Dividend is covered by both earnings (66% earnings payout ratio) and cash flows (55% cash payout ratio). The dividend has increased by an average of 17% per year over the past 10 years. However, payments have been volatile during that time. EPS is expected to grow by 40% over the next 3 years, which should provide support to the dividend and adequate earnings cover.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "a229b3e0-a1ed-4164-b922-0cd29323db4d",
      "type": "brief",
      "date": "2026-04-22T12:42:56.000Z",
      "title": "Full year 2026 earnings released: EPS: ₹18.15 (vs ₹16.64 in FY 2025)",
      "body": "Full year 2026 results: EPS: ₹18.15 (up from ₹16.64 in FY 2025). Revenue: ₹231.5b (up 15% from FY 2025). Net income: ₹35.0b (up 9.1% from FY 2025). Profit margin: 15% (in line with FY 2025). Revenue is forecast to grow 9.9% p.a. on average during the next 3 years, compared to a 10% growth forecast for the Food industry in India. Over the last 3 years on average, earnings per share has increased by 6% per year whereas the company’s share price has increased by 10% per year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
