    {
      "id": "8231303d-29bb-433e-bbe6-6e3dbc2d9798",
      "type": "brief",
      "date": "2026-01-31T21:37:59.000Z",
      "title": "Third quarter 2026 earnings released: EPS: ₹5.17 (vs ₹3.57 in 3Q 2025)",
      "body": "Third quarter 2026 results: EPS: ₹5.17 (up from ₹3.57 in 3Q 2025). Revenue: ₹56.7b (up 19% from 3Q 2025). Net income: ₹9.98b (up 45% from 3Q 2025). Profit margin: 18% (up from 14% in 3Q 2025). The increase in margin was driven by higher revenue. Revenue is forecast to grow 9.3% p.a. on average during the next 3 years, compared to a 9.8% growth forecast for the Food industry in India. Over the last 3 years on average, earnings per share has increased by 7% per year whereas the company’s share price has increased by 12% per year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "ecbf682c-fbdd-4994-a0cb-8328048dca6b",
      "type": "event",
      "date": "2026-01-30T08:20:00.000Z",
      "title": "Nestlé India Limited Declares Interim Dividend for the Financial Year 2025 - 2026, Payable on and from February 26, 2026",
      "body": "The Board of Directors of Nestlé India Limited have declared an Interim Dividend of INR 7/- per equity share of the face value of INR 1/- each for the financial year 2025-26 on the entire issued, subscribed and paid-up share capital of 1,928,314,320 equity shares of the Company, which will be paid on and from 26 February 2026 to those members whose names appear in the Register of Members of the Company or in the Register of Beneficial Owners maintained by the Depositories, as on the Record Date fixed for the purpose i.e. 6 February 2026, as already intimated by the Company to the Stock Exchanges vide its letter no. PKR:SG:JK: 98:2025-26 & PKR:SG:JK: 99:2025-26 both dated 16 January 2026. The meeting of board of director of the company was held on January 30, 2026.",
      "keyDevTypeId": "47",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "c90e9705-a38b-44ba-b2d7-23260e324c88",
      "type": "brief",
