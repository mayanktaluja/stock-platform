    {
      "id": "c91e3f54-7d1c-4880-85ca-01f244aa4890",
      "type": "brief",
      "date": "2026-02-08T23:58:34.000Z",
      "title": "Dividend of ₹160 announced",
      "body": "Shareholders will receive a dividend of ₹160. Ex-date: 12th February 2026 Payment date: 4th March 2026 Dividend yield will be 3.9%, which is higher than the industry average of 0.8%. Sustainability & Growth The dividend has increased by an average of 32% per year over the past 10 years. However, payments have been volatile during that time. The company's earnings per share (EPS) would need to grow by 22% to bring the payout ratio under control, which is more than the 6.0% EPS growth achieved over the last 5 years.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "5995e635-5594-43fe-bee3-e329a2f37af5",
      "type": "brief",
      "date": "2026-02-07T20:52:44.000Z",
      "title": "Third quarter 2026 earnings released: EPS: ₹46.74 (vs ₹54.76 in 3Q 2025)",
      "body": "Third quarter 2026 results: EPS: ₹46.74 (down from ₹54.76 in 3Q 2025). Revenue: ₹3.78b (up 21% from 3Q 2025). Net income: ₹775.9m (down 15% from 3Q 2025). Profit margin: 21% (down from 29% in 3Q 2025). The decrease in margin was driven by higher expenses. Revenue is forecast to grow 9.1% p.a. on average during the next 2 years, compared to a 10% growth forecast for the Pharmaceuticals industry in India. Over the last 3 years on average, earnings per share has increased by 9% per year but the company’s share price has only increased by 3% per year, which means it is significantly lagging earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
