    {
      "id": "e58f3934-f4d1-4c21-93dd-5ec4451cb04d",
      "type": "event",
      "date": "2026-06-08T15:24:00.000Z",
      "title": "Lemon Tree Hotels Limited Announces Appointment of Kartikeya Kumar Singh as Chief Digital and Transformation Officer & Senior Management Personnel, Effective June 08, 2026",
      "body": "Lemon Tree Hotels Limited announced that Mr. Kartikeya Kumar Singh was appointed as Chief Digital and Transformation Officer & Senior Management Personnel of the Company, effective June 08, 2026. Mr. Kartikeya Kumar Singh holds a PG Diploma in IT & Management Systems from Symbiosis Centre for Management & Human Resource Development, Pune and a Bachelor’s degree in Architecture from Bengal Engineering & Science University, Kolkata. He has a total experience of 23 years in digital transformation, analytics, technology strategy, and consumer goods operations. He commenced his professional journey with Videocon International Limited in 2003. Subsequently, he worked with Godrej Sara Lee Ltd., Phillips Electronics India Ltd., Pernod Ricard India Pvt. Ltd., Jubilant Life Sciences Limited and Adid",
      "keyDevTypeId": "16",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "7509c2b1-579b-42d6-b9b3-d038edda1470",
      "type": "narrative-update",
      "date": "2026-06-04T10:05:03.000Z",
      "title": "LEMONTREE: New India And Nepal Signings Will Drive Room-Led Upside",
      "body": "Analysts have adjusted their price target for Lemon Tree Hotels to about ₹157 from roughly ₹184, reflecting updated assumptions that include slightly lower revenue growth expectations, a modestly higher profit margin, and a recalibrated forward P/E multiple. What's in the News A board meeting is scheduled for May 28, 2026, to consider and approve audited standalone and consolidated financial results for the quarter and year ended March 31, 2026.",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/consumer-services/nse-lemontree/lemon-tree-hotels-shares/bd7ybrd0-renovations-and-franchise-expansion-will-unlock-indias-hospitality-potential-joss/updates/16-analysts-have-adjusted-their-price-target-for-lemon-tree-hot",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "2aa558a1-ea63-41f8-b7ec-aafcec9973f0",
      "type": "article",
      "date": "2026-05-31T04:08:28.000Z",
      "title": "Earnings Miss: Lemon Tree Hotels Limited Missed EPS By 11% And Analysts Are Revising Their Forecasts",
      "body": "Lemon Tree Hotels Limited ( NSE:LEMONTREE ) last week reported its latest yearly results, which makes it a good time...",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/stocks/in/consumer-services/nse-lemontree/lemon-tree-hotels-shares/news/earnings-miss-lemon-tree-hotels-limited-missed-eps-by-11-and",
      "raw_subtype": "article"
    },
    {
      "id": "052548c4-db2f-4f71-b2d3-0fef5bc15388",
      "type": "brief",
      "date": "2026-05-30T20:11:14.000Z",
      "title": "Full year 2026 earnings: EPS and revenues miss analyst expectations",
      "body": "Full year 2026 results: EPS: ₹2.87 (up from ₹2.48 in FY 2025). Revenue: ₹14.5b (up 13% from FY 2025). Net income: ₹2.27b (up 16% from FY 2025). Profit margin: 16% (in line with FY 2025). Revenue missed analyst estimates by 1.3%. Earnings per share (EPS) also missed analyst estimates by 11%. Revenue is forecast to grow 10% p.a. on average during the next 3 years, compared to a 17% growth forecast for the Hospitality industry in India. Over the last 3 years on average, earnings per share has increased by 25% per year but the company’s share price has only increased by 7% per year, which means it is significantly lagging earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "2bcaad13-7df3-4f08-8d57-3dc80fd454d1",
