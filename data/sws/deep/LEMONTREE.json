    {
      "id": "f02e7bc1-f63e-4e43-a5b5-9e0e6b4c5a3c",
      "type": "narrative",
      "date": "2026-04-23T18:05:28.000Z",
      "title": "Managed Room Pipeline And Renovation Program Will Shape A Balanced Long Term Outlook",
      "body": "Catalysts About Lemon Tree Hotels Lemon Tree Hotels operates a large midscale and upper midscale hotel network in India, with a growing presence in management and franchise contracts and an emerging upper upscale Aurika brand. What are the underlying business or industry changes driving this perspective?",
      "keyDevTypeId": null,
