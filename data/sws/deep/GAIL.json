    {
      "id": "ced44c1b-33a9-4b33-81b6-364085e7b691",
      "type": "narrative-update",
      "date": "2026-04-21T16:06:51.000Z",
      "title": "GAIL: Solar Expansion And New Leadership Will Support Future Upside",
      "body": "The analyst price target for GAIL (India) has shifted from about ₹191.65 to ₹187.65, with analysts citing updated views on revenue growth, profit margins, and future P/E assumptions to support the change. What's in the News GAIL approved 700 MW of solar power projects with planned investment of ₹38,000 million across Uttar Pradesh and Maharashtra, including large scale battery energy storage systems intended to support captive power needs at its petrochemical and PDH PP plants (Key Developments).",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/utilities/nse-gail/gail-india-shares/l92et013-gail-pipeline-completion-and-partnerships-will-drive-energy-transformation-ahead/updates/21-the-analyst-price-target-for-gail-india-has-shifted-from-a",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "617f05ab-3dcf-40da-b1e0-08964534f74c",
      "type": "narrative-update",
      "date": "2026-04-04T08:05:28.000Z",
      "title": "GAIL: Upcoming Renewables Expansion And New Leadership Will Support Future Upside",
