  "news": [
    {
      "id": "f3413688-b21a-43ff-978a-986adffc4df5",
      "type": "brief",
      "date": "2026-04-15T11:49:41.000Z",
      "title": "Upcoming dividend of ₹7.00 per share",
      "body": "Eligible shareholders must have bought the stock before 22 April 2026. Payment date: 29 May 2026. Payout ratio is a comfortable 32% and this is well supported by cash flows. Trailing yield: 1.4%. Lower than top quartile of Indian dividend payers (1.5%). Higher than average of industry peers (0.6%).",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "44c0c03f-8eec-4305-85c0-b970f64aca17",
      "type": "brief",
      "date": "2026-04-05T23:43:21.000Z",
      "title": "Full year 2025 earnings: EPS misses analyst expectations",
      "body": "Full year 2025 results: EPS: ₹21.69 (up from ₹21.62 in FY 2024). Revenue: ₹94.1b (up 4.9% from FY 2024). Net income: ₹8.23b (flat on FY 2024). Profit margin: 8.7% (down from 9.2% in FY 2024). The decrease in margin was driven by higher expenses. Revenue was in line with analyst estimates. Earnings per share (EPS) missed analyst estimates by 2.7%. Revenue is forecast to grow 7.7% p.a. on average during the next 3 years, compared to a 11% growth forecast for the Auto Components industry in India. Over the last 3 years on average, earnings per share has increased by 2% per year whereas the company’s share price has increased by 7% per year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "b2088ea1-a85b-4a8a-a3e8-0776cc895aba",
      "type": "event",
      "date": "2026-03-26T10:48:00.000Z",
      "title": "CIE Automotive India Limited to Report Q1, 2026 Results on Apr 23, 2026",
      "body": "CIE Automotive India Limited announced that they will report Q1, 2026 results on Apr 23, 2026",
      "keyDevTypeId": "55",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "0808dd95-a923-46c1-a70c-fdc8f503d5ec",
      "type": "brief",
      "date": "2026-02-23T08:04:59.000Z",
      "title": "Price target increased by 7.7% to ₹509",
      "body": "Up from ₹472, the current price target is an average from 4 analysts. New target price is 8.3% above last closing price of ₹469. Stock is up 16% over the past year. The company is forecast to post earnings per share of ₹22.43 for next year compared to ₹21.62 last year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "af53ae4a-5d97-44c9-a037-284473ec3785",
      "type": "brief",
      "date": "2026-02-23T08:04:58.000Z",
      "title": "Now 21% overvalued after recent price rise",
      "body": "Over the last 90 days, the stock has risen 14% to ₹469. The fair value is estimated to be ₹389, however this is not to be taken as a sell recommendation but rather should be used as a guide only. Revenue has been flat over the last 3 years. Earnings per share has grown by 4.9%. For the next 3 years, revenue is forecast to grow by 7.8% per annum. Earnings are also forecast to grow by 12% per annum over the same time period.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "97f64fe4-b403-4cf5-b4a9-1ab9cea9214d",
      "type": "brief",
      "date": "2026-02-21T20:07:55.000Z",
      "title": "Dividend of ₹7.00 announced",
      "body": "Dividend of ₹7.00 is the same as last year. Ex-date: 22nd April 2026 Payment date: 29th May 2026 Dividend yield will be 1.5%, which is higher than the industry average of 0.6%. Sustainability & Growth Dividend is covered by both earnings (32% earnings payout ratio) and cash flows (71% cash payout ratio). The dividend has increased by an average of 29% per year over the past 4 years and payments have been stable during that time. EPS is expected to grow by 41% over the next 3 years, which should provide support to the dividend and adequate earnings cover.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
