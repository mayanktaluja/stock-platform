    {
      "id": "357701e9-0218-4f9b-a0b9-f8ed9791e850",
      "type": "brief",
      "date": "2026-05-22T11:32:02.000Z",
      "title": "Consensus EPS estimates fall by 17%",
      "body": "The consensus outlook for earnings per share (EPS) in fiscal year 2027 has deteriorated. 2027 revenue forecast decreased from ₹149.7b to ₹140.3b. EPS estimate also fell from ₹11.10 per share to ₹9.20 per share. Net income forecast to grow 16% next year vs 23% growth forecast for Luxury industry in India. Consensus price target of ₹410 unchanged from last update. Share price rose 2.9% to ₹288 over the past week.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "03f6638d-0584-478b-8f9c-f05b4453091a",
      "type": "brief",
      "date": "2026-05-17T23:05:40.000Z",
      "title": "Final dividend of ₹1.65 announced",
      "body": "Shareholders will receive a dividend of ₹1.65. Ex-date: 24th July 2026 Payment date: 30th August 2026 Dividend yield will be 1.2%, which is higher than the industry average of 0.4%. Sustainability & Growth Dividend is well covered by both earnings (44% earnings payout ratio) and cash flows (7% cash payout ratio). The dividend has increased by an average of 1.2% per year over the past 5 years. However, payments have been volatile during that time. EPS is expected to grow by 72% over the next 2 years, which should provide support to the dividend and adequate earnings cover.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "9164da67-9558-426c-8d7c-8225366feeaa",
      "type": "brief",
      "date": "2026-05-17T23:05:39.000Z",
      "title": "Full year 2026 earnings: EPS and revenues miss analyst expectations",
      "body": "Full year 2026 results: EPS: ₹7.91 (down from ₹11.44 in FY 2025). Revenue: ₹132.1b (up 5.0% from FY 2025). Net income: ₹1.12b (down 29% from FY 2025). Profit margin: 0.8% (down from 1.2% in FY 2025). The decrease in margin was driven by higher expenses. Revenue missed analyst estimates by 3.7%. Earnings per share (EPS) also missed analyst estimates by 14%. Revenue is forecast to grow 11% p.a. on average during the next 2 years, compared to a 12% growth forecast for the Luxury industry in India. Over the last 3 years on average, earnings per share has fallen by 30% per year but the company’s share price has only fallen by 5% per year, which means it has not declined as severely as earnings.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
