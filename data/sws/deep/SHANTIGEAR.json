    {
      "id": "7e95e0e7-bd66-472c-8ee5-5aa90ab369d2",
      "type": "event",
      "date": "2026-05-05T07:14:00.000Z",
      "title": "Shanthi Gears Limited Recommends Final Dividend for the Financial Year Ended March 31, 2026, Payable on or Before August 27, 2026",
      "body": "Shanthi Gears Limited announced that at the board meeting held on April 24, 2026, The Board of Directors has recommended a final dividend of INR 2/- (Rupees Two only) per equity share of INR 1/- each (ISIN INE631A01022) for the financial year ended 31st March, 2026 together with the interim dividend of INR 3/- per share, paid on 20th February, 2026, the total dividend for the financial year 2025-26 works out to INR 5/- (Rupees Five only) per share. The said final dividend, if approved by the Members at the upcoming AGM, will be paid within 30 days from the date of the AGM (i.e., on or before 27th August, 2026).",
      "keyDevTypeId": "45",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "681db64a-e41f-41aa-8066-dd4ef2cabd53",
      "type": "event",
      "date": "2026-05-05T07:14:00.000Z",
      "title": "Shanthi Gears Limited Announces Board and Executive Changes",
      "body": "Shanthi Gears Limited announced that at the board meeting held on April 24, 2026, Mr. L Ramkumar, Independent Director of the Company retires on completion of his term by 06th May, 2026. Mr. Suresh P L, would be stepping down as Head ­ Technology of the Company effective closing hours of on 13th June, 2026 to pursue career prospects outside the Company.",
      "keyDevTypeId": "16",
      "source_url": null,
