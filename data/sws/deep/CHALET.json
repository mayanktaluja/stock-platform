      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/consumer-services/nse-chalet/chalet-hotels-shares/x3gxq8ad-india-urbanization-will-expand-hospitality-and-mixed-use-assets-ae2x/updates/17-analysts-have-made-a-marginal-trim-to-their-chalet-hotels-pr",
