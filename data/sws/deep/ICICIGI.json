    {
      "id": "5a2ed8fc-6b0d-445f-a31b-8da394ea1106",
      "type": "brief",
      "date": "2026-04-18T20:06:21.000Z",
      "title": "Full year 2026 earnings: EPS misses analyst expectations",
      "body": "Full year 2026 results: EPS: ₹55.74 (up from ₹50.74 in FY 2025). Revenue: ₹270.1b (up 13% from FY 2025). Net income: ₹27.7b (up 11% from FY 2025). Profit margin: 10% (in line with FY 2025). Combined ratio: 103.4% (up from 102.8% in FY 2025). Revenue was in line with analyst estimates. Earnings per share (EPS) missed analyst estimates by 3.9%. Revenue is forecast to grow 11% p.a. on average during the next 3 years, compared to a 10% growth forecast for the Insurance industry in India. Over the last 3 years on average, earnings per share has increased by 18% per year whereas the company’s share price has increased by 21% per year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "60c1de0d-af4a-42d5-818c-1fbca069de87",
      "type": "event",
      "date": "2026-04-15T13:28:00.000Z",
