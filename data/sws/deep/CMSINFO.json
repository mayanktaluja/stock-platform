    {
      "id": "5a06db5d-f1ab-4922-aee8-a5abbc516ee5",
      "type": "brief",
      "date": "2026-05-17T22:38:35.000Z",
      "title": "Full year 2026 earnings: EPS and revenues miss analyst expectations",
      "body": "Full year 2026 results: EPS: ₹18.45 (down from ₹22.79 in FY 2025). Revenue: ₹25.3b (up 4.5% from FY 2025). Net income: ₹3.03b (down 19% from FY 2025). Profit margin: 12% (down from 15% in FY 2025). The decrease in margin was driven by higher expenses. Revenue missed analyst estimates by 1.8%. Earnings per share (EPS) also missed analyst estimates by 4.2%. Revenue is forecast to grow 11% p.a. on average during the next 3 years, compared to a 11% growth forecast for the Commercial Services industry in India. Over the last 3 years on average, earnings per share has remained flat whereas the company’s share price has fallen by 1% per year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "e648689f-a23d-4007-87a7-2f0587c9676b",
      "type": "event",
      "date": "2026-05-14T16:38:00.000Z",
      "title": "CMS Info Systems Limited (NSEI:CMSINFO) announces an Equity Buyback for 4,939,126 shares, representing 3% for INR 1,679.3 million.",
      "body": "CMS Info Systems Limited (NSEI:CMSINFO) announces a share repurchase program. Under the program, the company will repurchase up to 4,939,126 shares, representing 3% for INR 1,679.3 million. The shares will be repurchased at a price of INR 340 per share. The Board has fixed Friday, May 22, 2026 as the record date. As of March 31, 2026, the company had 164,637,541  shares issued and outstanding.",
      "keyDevTypeId": "232",
      "source_url": null,
      "raw_subtype": "EventActivity"
