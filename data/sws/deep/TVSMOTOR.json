      "raw_subtype": "EventActivity"
    },
    {
      "id": "e5010eb5-9b1f-4faa-9b90-878439fa6a6e",
      "type": "brief",
      "date": "2026-01-29T11:47:00.000Z",
      "title": "Third quarter 2026 earnings released: EPS: ₹17.71 (vs ₹11.91 in 3Q 2025)",
