  "news": [
    {
      "id": "72c0984b-8973-423e-b53e-99a05a3c6d78",
      "type": "narrative-update",
      "date": "2026-04-22T14:08:30.000Z",
      "title": "METROBRAND: Measured Store Expansion And New Formats Will Support Future Returns",
      "body": "Analysts have slightly reduced their price target for Metro Brands to around ₹1,198 from about ₹1,211, reflecting updated assumptions on discount rate, revenue growth, profit margin, and forward P/E that leave the core outlook broadly unchanged. What's in the News During Third Quarter FY26, Metro Brands opened 35 new stores and closed 11, with 100 openings and 18 closures over the nine month period, indicating a measured approach to expanding its retail footprint (Key Developments).",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/retail/nse-metrobrand/metro-brands-shares/n0ztydha-analysts-lift-metro-brands-price-target-as-profit-margins-improve-and-dividends-announced/updates/20-analysts-have-slightly-reduced-their-price-target-for-metro",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "f50ed48e-c612-4bbc-9c1a-2f5e67e18931",
