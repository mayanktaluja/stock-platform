    {
      "id": "be925872-0ab4-4987-a908-7be067010400",
      "type": "narrative-update",
      "date": "2026-01-07T11:04:43.000Z",
      "title": "METROBRAND: New Sports Format And Online Push Will Shape Future Returns",
