    {
      "id": "edfc1c38-28ce-44dc-b5be-4f41f6b6ecd4",
      "type": "narrative-update",
      "date": "2026-04-07T00:13:59.000Z",
      "title": "AUROPHARMA: Higher Margin Assumptions And Buybacks Will Shape A Balanced Outlook",
