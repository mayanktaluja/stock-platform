    {
      "id": "39db4feb-47e5-4e6d-91f4-432f3e1c2c41",
      "type": "brief",
      "date": "2026-05-08T16:49:07.000Z",
      "title": "Full year 2026 earnings released: EPS: ₹117 (vs ₹71.95 in FY 2025)",
      "body": "Full year 2026 results: EPS: ₹117 (up from ₹71.95 in FY 2025). Revenue: ₹279.6b (up 23% from FY 2025). Net income: ₹53.3b (up 63% from FY 2025). Profit margin: 19% (up from 14% in FY 2025). The increase in margin was driven by higher revenue. Revenue is forecast to grow 3.5% p.a. on average during the next 2 years, compared to a 12% growth forecast for the Pharmaceuticals industry in India. Over the last 3 years on average, earnings per share has increased by 55% per year but the company’s share price has only increased by 45% per year, which means it is significantly lagging earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "e8d71827-8705-4938-82d6-72a8f88ab1b4",
      "type": "event",
      "date": "2026-05-05T16:41:00.000Z",
      "title": "Lupin Limited Receives U.S. FDA Approval For Glycerol Phenylbutyrate Oral Liquid",
      "body": "Lupin Limited announced that it has received approval from the United States Food and Drug Administration for its Abbreviated New Drug Applications for Glycerol Phenylbutyrate Oral Liquid, 1.1 grams per mL. Glycerol Phenylbutyrate Oral Liquid, 1.1 grams per mL, is bioequivalent to the reference listed drug (RLD), Ravicti Oral Liquid, 1.1 grams per mL, of Horizon Therapeutics U.S. Holding LLC. It is indicated for chronic management of patients with urea cycle disorders (UCDs) that cannot be managed by dietary protein restriction and/or amino acid supplementation alone. The product sales for Glycerol Phenylbutyrate Oral Liquid (RLD Ravicti) were USD 337 million for the year ended December 2025.",
      "keyDevTypeId": "41",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
