    {
      "id": "859b6822-8afc-4d1c-99cc-b8d9a03a22f5",
      "type": "article",
      "date": "2026-04-30T00:24:29.000Z",
      "title": "Earnings Update: UltraTech Cement Limited (NSE:ULTRACEMCO) Just Reported Its Full-Year Results And Analysts Are Updating Their Forecasts",
      "body": "Shareholders might have noticed that UltraTech Cement Limited ( NSE:ULTRACEMCO ) filed its annual result this time last...",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/stocks/in/materials/nse-ultracemco/ultratech-cement-shares/news/earnings-update-ultratech-cement-limited-nseultracemco-just",
      "raw_subtype": "article"
    },
    {
      "id": "a44e81fd-9632-4b23-99d3-55067588055a",
      "type": "brief",
      "date": "2026-04-28T11:30:31.000Z",
      "title": "Full year 2026 earnings: Revenues and EPS in line with analyst expectations",
      "body": "Full year 2026 results: EPS: ₹278 (up from ₹205 in FY 2025). Revenue: ₹890.9b (up 17% from FY 2025). Net income: ₹81.7b (up 35% from FY 2025). Profit margin: 9.2% (up from 8.0% in FY 2025). The increase in margin was driven by higher revenue. Revenue was in line with analyst estimates. Earnings per share (EPS) were also in line with analyst expectations. Revenue is forecast to grow 10% p.a. on average during the next 3 years, compared to a 1.0% decline forecast for the Basic Materials industry in India. Over the last 3 years on average, earnings per share has increased by 11% per year but the company’s share price has increased by 17% per year, which means it is tracking significantly ahead of earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "34459013-8dc5-4722-afd1-17ee5f56e4ff",
      "type": "narrative-update",
      "date": "2026-04-25T21:09:44.000Z",
      "title": "ULTRACEMCO: Capacity Expansion Will Drive Future Upside Despite GST Disputes",
      "body": "Analysts have revised their 12 month fair value estimate for UltraTech Cement to ₹13,636 from ₹14,045, reflecting updated assumptions for revenue growth, profit margins and forward P/E multiples. What's in the News Commissioning of 8.7 mtpa of new cement grinding capacity across Shahjahanpur in Uttar Pradesh, Visakhapatnam in Andhra Pradesh and Patratu in Jharkhand, taking domestic grey cement capacity to 200.1 mtpa and global capacity to 205.5 mtpa (company disclosure).",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/materials/nse-ultracemco/ultratech-cement-shares/dirg1ome-robust-indian-infrastructure-will-unlock-cement-opportunity-iphk/updates/17-analysts-have-revised-their-12-month-fair-value-estimate-for",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "c869bf7e-d1b5-411e-b9b0-fcc45b045921",
      "type": "narrative-update",
      "date": "2026-03-26T13:08:55.000Z",
      "title": "ULTRACEMCO: Expanding Capacity Will Drive Future Upside Despite Ongoing GST Disputes",
      "body": "The analyst fair value estimate for UltraTech Cement has moved slightly from ₹14,090.92 to ₹14,044.87, with the adjustment linked to modest tweaks in the discount rate, revenue growth, profit margin and future P/E assumptions as analysts refine their models. What's in the News UltraTech Cement received multiple GST orders from state and central authorities in Maharashtra, Tamil Nadu and Haryana related to alleged ineligible or excess Input Tax Credit and supplies to customers later deemed non existent, with combined tax demands, interest and penalties across various years that the company plans to contest, while indicating it does not expect a material financial impact.",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/materials/nse-ultracemco/ultratech-cement-shares/dirg1ome-robust-indian-infrastructure-will-unlock-cement-opportunity-iphk/updates/16-the-analyst-fair-value-estimate-for-ultratech-cement-has-mov",
      "raw_subtype": "narrative-update"
    },
