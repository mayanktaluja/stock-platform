    {
      "id": "a477ca35-9f86-45d2-97a9-47e20a212a2d",
      "type": "narrative-update",
      "date": "2026-01-19T12:06:19.000Z",
      "title": "KPIL: Metro Order Wins Will Drive Future Upside Potential",
