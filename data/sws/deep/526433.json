    {
      "id": "9acc0283-1d92-4936-8312-8fa3f6e0d2d4",
      "type": "event",
      "date": "2026-02-20T00:00:00.000Z",
      "title": "ASM Technologies Limited (BSE:526433) entered into a definitive agreement to acquire 20% stake in Myelin Foundry Pvt Ltd. for INR 480 million.",
      "body": "ASM Technologies Limited (BSE:526433) entered into a definitive agreement to acquire 20% stake in Myelin Foundry Pvt Ltd. for INR 480 million on February 20, 2026. A cash consideration of INR 480 million will be paid by ASM Technologies Limited.\n\nFor the period ending March 31, 2025, Myelin Foundry Pvt Ltd. reported total revenue of INR 56.41 million.\n\nThe transaction has been approved by the board of directors of ASM Technologies Limited. The transaction is expected to close in 12 months.",
      "keyDevTypeId": "80",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "6aa8e15d-61b2-4753-bb79-1648bb826caf",
      "type": "brief",
      "date": "2026-02-04T11:34:36.000Z",
      "title": "Third quarter 2026 earnings released: EPS: ₹6.38 (vs ₹4.40 in 3Q 2025)",
      "body": "Third quarter 2026 results: EPS: ₹6.38 (up from ₹4.40 in 3Q 2025). Revenue: ₹1.16b (up 75% from 3Q 2025). Net income: ₹93.1m (up 131% from 3Q 2025). Profit margin: 8.0% (up from 6.1% in 3Q 2025). The increase in margin was driven by higher revenue. Over the last 3 years on average, earnings per share has increased by 72% per year but the company’s share price has increased by 81% per year, which means it is tracking significantly ahead of earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "36aeaf80-5ca7-42de-a8a9-8cea5cbb71a3",
      "type": "brief",
      "date": "2026-02-04T11:34:35.000Z",
      "title": "Third quarter dividend of ₹2.50 announced",
      "body": "Shareholders will receive a dividend of ₹2.50. Ex-date: 11th February 2026 Payment date: 28th February 2026 Dividend yield will be 0.3%, which is lower than the industry average of 1.7%. Sustainability & Growth Dividend is covered by earnings (9% earnings payout ratio) but the company has no free cash flows available, indicating it may be using cash reserves or debt to pay the dividend. The dividend has increased by an average of 15% per year over the past 10 years. However, payments have been volatile during that time. Earnings per share has grown by 29% over the last 5 years. Unless this trend reverses, it should provide support to the dividend and adequate earnings cover.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
