    {
      "id": "2c978555-b35d-4448-acd4-687edbd5f556",
      "type": "narrative-update",
      "date": "2026-06-06T01:08:02.000Z",
      "title": "HITECH: Upcoming Equity Warrant Issue Will Offer Attractive Long Term Upside Potential",
      "body": "Analysts have reduced their price target on Hi-Tech Pipes from ₹180 to ₹116 as they now apply a higher discount rate and a lower future P/E multiple, while keeping margin expectations broadly similar. What's in the News A board meeting is scheduled for May 28, 2026 to consider the annual audited standalone and consolidated financial results for the quarter and financial year ended March 31, 2026, and to review options for raising funds through equity shares, fully convertible warrants, convertible instruments, or a mix of securities, subject to shareholder approval.",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/materials/nse-hitech/hi-tech-pipes-shares/fuujt4vz-growing-urbanization-and-renewables-will-drive-indias-steel-pipe-demand-3n5l/updates/2-analysts-have-reduced-their-price-target-on-hi-tech-pipes-fr",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "bf5b404f-3af9-4a6a-baf0-007366b0f1d8",
      "type": "brief",
      "date": "2026-05-29T02:20:24.000Z",
      "title": "Full year 2026 earnings: Revenues exceed analysts expectations while EPS lags behind",
      "body": "Full year 2026 results: EPS: ₹3.77. Revenue: ₹42.0b (up 37% from FY 2025). Net income: ₹761.6m (up 4.4% from FY 2025). Profit margin: 1.8% (down from 2.4% in FY 2025). The decrease in margin was driven by higher expenses. Revenue exceeded analyst estimates by 17%. Earnings per share (EPS) missed analyst estimates by 5.8%. Revenue is forecast to grow 13% p.a. on average during the next 2 years, compared to a 12% growth forecast for the Metals and Mining industry in India.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
