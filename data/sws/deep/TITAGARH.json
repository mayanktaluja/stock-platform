    {
      "id": "0ca545b1-8512-4fc9-8797-1869e30a371c",
      "type": "event",
      "date": "2026-02-17T00:00:00.000Z",
      "title": "Jindal Power, Vedanta and Havells Reportedly Among 22 Bidders for Gupta Power",
      "body": "Jindal Power Limited, Vedanta Limited (NSEI:VEDL) and Havells India Limited (NSEI:HAVELLS) are among 22 prospective bidders that have submitted expressions of interest (EoIs) to acquire debt-laden Gupta Power Infrastructure Limited, which has admitted debtor claims of INR 42,400 million and is undergoing insolvency proceedings, people aware of the development told ET. The company, which is a manufacturer of cables, wire rods, and conductors, is being resolved under the corporate insolvency resolution process (CIRP). Other interested bidders include UltraTech Cement Limited (NSEI:ULTRACEMCO), Waaree Energies Limited (NSEI:WAAREEENER), Torrent Electricals (TCL Cables Private Limited) and Himadri Speciality Chemical Limited (BSE:500184), Orissa Metaliks Private Limited and Abci Infrastructure",
      "keyDevTypeId": "65",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "73efb332-b1e5-49bb-9f1a-5cf8f76d9f1d",
      "type": "brief",
      "date": "2026-02-16T07:42:51.000Z",
      "title": "Third quarter 2026 earnings released: EPS: ₹3.59 (vs ₹4.63 in 3Q 2025)",
      "body": "Third quarter 2026 results: EPS: ₹3.59 (down from ₹4.63 in 3Q 2025). Revenue: ₹8.43b (down 6.6% from 3Q 2025). Net income: ₹481.2m (down 23% from 3Q 2025). Profit margin: 5.7% (down from 6.9% in 3Q 2025). The decrease in margin was driven by lower revenue. Revenue is forecast to grow 35% p.a. on average during the next 3 years, compared to a 13% growth forecast for the Machinery industry in India. Over the last 3 years on average, earnings per share has increased by 13% per year but the company’s share price has increased by 52% per year, which means it is tracking significantly ahead of earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
