    {
      "id": "a9fc37a4-4030-4c87-bb96-f4e05451f7cb",
      "type": "event",
      "date": "2026-03-03T00:00:00.000Z",
      "title": "SAR Televenture Limited (NSEI:SARTELE) entered share purchase agreement to acquire 70.17% stake in Grand Foundry Limited (BSE:513343) from Gaurav Goyal and Rakesh Kumar Bsnsal for INR 32 million.",
      "body": "SAR Televenture Limited (NSEI:SARTELE) entered share purchase agreement to acquire 70.17% stake in Grand Foundry Limited (BSE:513343) from Gaurav Goyal and Rakesh Kumar Bsnsal for INR 32 million on March 3, 2026. A cash consideration of INR 32.03 million will be paid by SAR Televenture Limited. As part of consideration, INR 32.03 million is paid towards common equity of Grand Foundry Limited. Board of SAR Televenture Limited approved the transaction. In a related transaction, acquisition of up to 79,11,800 equity shares at INR 2.50 per share, representing 26% of the total stake of Grand Foundry Limited, from its public shareholders through open offer. The transaction will be completed within six months.",
      "keyDevTypeId": "80",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "bb97e963-26d0-4f28-b2c1-8b9068ee4202",
      "type": "event",
      "date": "2026-03-03T00:00:00.000Z",
      "title": "SAR Televenture Limited (NSEI:SARTELE) proposed to acquire 26% stake in Grand Foundry Limited (BSE:513343) for INR 19.8 million.",
      "body": "SAR Televenture Limited (NSEI:SARTELE) proposed to acquire 26% stake in Grand Foundry Limited (BSE:513343) for INR 19.8 million on March 3, 2026. A cash consideration of INR 2.5 per share million will be paid by SAR Televenture Limited. In a related transaction, SAR Televenture Limited (NSEI:SARTELE) entered share purchase agreement to acquire 70.17% stake in Grand Foundry Limited (BSE:513343) from Gaurav Goyal and Rakesh Kumar Bsnsal for INR 32 million. \n\nThe transaction is subject to approval of offer by acquirer board. The deal has been approved by the board. The transaction will be completed within six months.\n\nRadhika Pushkarna of D&A Financial Services (P) Limited acted as the manager to the offer for SAR Televenture Limited.",
      "keyDevTypeId": "80",
      "source_url": null,
