    {
      "id": "f0cfdfb9-8203-47df-9af9-88ba23e65de2",
      "type": "event",
      "date": "2026-01-21T13:55:00.000Z",
      "title": "Allcargo Global Limited Announces Appointment of Vaishnav Shetty as Deputy Managing Director and Induction into Board of Directors, Effective January 21, 2026",
      "body": "Allcargo Global Limited announced the appointment of Vaishnav Shetty as Deputy Managing Director, with immediate effect 21 January 2026. He has also been inducted as a member of the Board of Directors of Allcargo Global Limited. Vaishnav Shetty, son of Allcargo Group Founder and Chairman Shashi Kiran Shetty, will work with Adarsh Hegde, Managing Director, Allcargo Global Limited. The appointment has been approved by the Board of Directors and comes during the Group's ongoing restructuring, under which its businesses are being reorganised into four independent entities. As part of this process, the International Supply Chain business has been demerged into Allcargo Global Limited, which is proposed to be listed.",
      "keyDevTypeId": "16",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
