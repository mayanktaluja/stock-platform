    {
      "id": "3853fdac-0768-4586-b130-6704576f9d9b",
      "type": "event",
      "date": "2026-02-16T13:02:00.000Z",
      "title": "Polymac Thermoformers Limited Announces Board Changes",
      "body": "Polymac Thermoformers Limited announced that Mr. Puspjeet Kumar resigned from his position as Director of the company effective February 14, 2026, due to personal and unavoidable circumstances. The company also approved the appointment of Mr. Jitendra Kumar Modi as Director of the company effective February 16, 2026. Mr. Jitendra Kumar Modi has been working in the field of Finance, Accounts, and Taxation and also manages the affairs related to accounting and taxation. Mr. Jitendra Kumar Modi is the husband of the Wholetime Director of the company. The board meeting was held on February 16, 2026.",
      "keyDevTypeId": "16",
      "source_url": null,
