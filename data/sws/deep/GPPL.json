    {
      "id": "c2d505b5-2da1-4407-be4f-3eb5c8ae07a7",
      "type": "narrative-update",
      "date": "2026-03-25T17:02:53.000Z",
      "title": "GPPL: Upcoming Results Review Will Support Bullish Outlook On Steady Assumptions",
