    {
      "id": "80d5da48-6c84-41d6-8dcb-fcae89ed6ed6",
      "type": "event",
      "date": "2026-02-20T13:00:00.000Z",
      "title": "Welspun Living Limited Appoints Manjinder Singh as Senior Vice President ­- Projects & Commercial, Senior Management Personnel, Effective February 20, 2026",
      "body": "Welspun Living Limited announced the appointment of Mr. Manjinder Singh as Senior Vice President -­ Projects & Commercial, Senior Management Personnel of the Company with effect from February 20, 2026. He will report to Ms. Dipali Goenka, Managing Director & CEO. Mr. Manjinder Singh comes with 24 years of experience, led large-scale capital projects and strategic procurement for leading organizations such as Vardhman Textiles, Welspun India, SEL Textiles, and LG Electronics. He brings deep expertise in greenfield and brownfield project execution, multi-billion-rupee CAPEX management and cost-effective, ethical sourcing and will play a key role in driving our projects, commercial operations and growth initiatives.",
      "keyDevTypeId": "16",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "1ad2cc7c-e016-4e0e-b266-235059c89ee9",
      "type": "brief",
      "date": "2026-02-13T12:17:28.000Z",
      "title": "Third quarter 2026 earnings: Revenues exceed analysts expectations while EPS lags behind",
      "body": "Third quarter 2026 results: EPS: ₹0.01 (down from ₹1.27 in 3Q 2025). Revenue: ₹22.8b (down 8.6% from 3Q 2025). Net income: ₹2.10m (down 100% from 3Q 2025). Profit margin: 0% (down from 4.9% in 3Q 2025). The decrease in margin was driven by lower revenue. Revenue exceeded analyst estimates by 3.1%. Earnings per share (EPS) missed analyst estimates by 57%. Revenue is forecast to grow 13% p.a. on average during the next 3 years, compared to a 14% growth forecast for the Luxury industry in India. Over the last 3 years on average, earnings per share has increased by 12% per year but the company’s share price has increased by 26% per year, which means it is tracking significantly ahead of earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
