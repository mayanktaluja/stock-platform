    {
      "id": "1070d763-1b61-4e1e-b91c-ed3da7889cd7",
      "type": "brief",
      "date": "2026-05-30T20:11:17.000Z",
      "title": "Full year 2026 earnings: EPS and revenues miss analyst expectations",
      "body": "Full year 2026 results: EPS: ₹9.05 (up from ₹6.02 in FY 2025). Revenue: ₹20.0b (up 5.9% from FY 2025). Net income: ₹1.97b (up 50% from FY 2025). Profit margin: 9.9% (up from 6.9% in FY 2025). The increase in margin was driven by higher revenue. Revenue missed analyst estimates by 8.0%. Earnings per share (EPS) also missed analyst estimates by 3.7%. Revenue is forecast to grow 6.5% p.a. on average during the next 3 years, compared to a 9.1% growth forecast for the Media industry in India. Over the last 3 years on average, earnings per share has fallen by 1% per year whereas the company’s share price has increased by 1% per year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
