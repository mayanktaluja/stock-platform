    {
      "id": "df59ffad-bf60-4ceb-a46d-caa1199a60f3",
      "type": "narrative-update",
      "date": "2026-04-25T23:07:52.000Z",
      "title": "HERITGFOOD: New Shamirpet Plant Will Support Future Premium Earnings Potential",
      "body": "Analysts have maintained their Heritage Foods fair value estimate at ₹415.00. Updated assumptions reflect more moderate revenue growth, a slightly lower profit margin, and a higher future P/E multiple supporting the unchanged price target.",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/food-beverage-tobacco/nse-heritgfood/heritage-foods-shares/zi7vk9bn-rising-plant-based-demand-and-digital-agri-tech-will-undermine-revenues/updates/7-analysts-have-maintained-their-heritage-foods-fair-value-est",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "7268b7c8-f58a-4c9b-9f1e-239c15f27931",
      "type": "narrative-update",
      "date": "2026-04-11T18:08:11.000Z",
      "title": "HERITGFOOD: New Shamirpet Facility Will Support Confident Long Term Earnings Outlook",
