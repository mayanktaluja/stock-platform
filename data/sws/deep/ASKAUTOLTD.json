    {
      "id": "432cb3d5-a509-479d-a2ea-c4d1917d3f1c",
      "type": "brief",
      "date": "2026-05-21T12:50:55.000Z",
      "title": "Dividend increased to ₹1.85",
      "body": "Dividend of ₹1.85 is 23% higher than last year. Ex-date: 31st July 2026 Payment date: 5th September 2026 Dividend yield will be 0.4%, which is lower than the industry average of 0.6%. Sustainability & Growth Dividend is covered by earnings (12% earnings payout ratio) but the company has no free cash flows available, indicating it may be using cash reserves or debt to pay the dividend. The dividend has increased by an average of 22% per year over the past 2 years and payments have been stable during that time. EPS is expected to grow by 53% over the next 3 years, which should provide support to the dividend and adequate earnings cover.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "27149629-bd87-4055-b352-038e2a4eefca",
      "type": "brief",
      "date": "2026-05-20T12:35:06.000Z",
      "title": "Full year 2026 earnings: EPS in line with analyst expectations despite revenue beat",
      "body": "Full year 2026 results: EPS: ₹15.08 (up from ₹12.56 in FY 2025). Revenue: ₹42.0b (up 17% from FY 2025). Net income: ₹2.97b (up 20% from FY 2025). Profit margin: 7.1% (up from 6.9% in FY 2025). The increase in margin was driven by higher revenue. Revenue exceeded analyst estimates by 2.5%. Earnings per share (EPS) were mostly in line with analyst estimates. Revenue is forecast to grow 9.6% p.a. on average during the next 2 years, compared to a 10% growth forecast for the Auto Components industry in India.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "a4a29d16-0edb-4aae-9c2c-4c8d585ee57a",
      "type": "event",
      "date": "2026-05-19T12:42:00.000Z",
      "title": "ASK Automotive Limited Recommends Final Dividend for the Financial Year 2025-26, Payable on or Before September 5, 2026",
      "body": "ASK Automotive Limited announced that at the Board Meeting Held on May 19, 2026, recommended final dividend of INR 1.85 /- (92.5%) per equity share of the face value of INR 2/- per equity share of the Company for the\nFinancial Year 2025-26, subject To Approve the shareholders of the Company in the upcoming Annual General Meeting (\"AGM\"). Fixed July 31, 2026, as the Record Date for determining entitlement of Members to final dividend for the Financial Year ended March 31, 2026, pursuant to Regulation 42 of the Securities and Exchange Board of India (Listing Obligations and Disclosure Requirements) Regulations, 2015. The dividend, if declared by shareholders at the AGM, shall be paid on or before September 5, 2026.",
      "keyDevTypeId": "46",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
