    {
      "id": "8e74ab49-4059-4a64-b3f4-bf49e127b49c",
      "type": "brief",
      "date": "2026-02-11T12:04:28.000Z",
      "title": "Dividend of ₹7.00 announced",
      "body": "Shareholders will receive a dividend of ₹7.00. Ex-date: 16th February 2026 Payment date: 11th March 2026 Dividend yield will be 7.4%, which is higher than the industry average of 0.6%. Sustainability & Growth Dividend is covered by both earnings (53% earnings payout ratio) and cash flows (51% cash payout ratio). The dividend has decreased over the past 36 years, indicating a lack of growth and stability in payments. Earnings per share has grown by 6.9% over the last 5 years. Unless this trend reverses, it should provide support to the dividend and adequate earnings cover.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "0e46ae8b-dd92-4b16-84bc-c9c400f913fb",
      "type": "brief",
      "date": "2026-02-10T11:35:44.000Z",
      "title": "Third quarter 2026 earnings released: EPS: ₹7.38 (vs ₹4.24 in 3Q 2025)",
      "body": "Third quarter 2026 results: EPS: ₹7.38 (up from ₹4.24 in 3Q 2025). Revenue: ₹2.87b (up 38% from 3Q 2025). Net income: ₹333.2m (up 74% from 3Q 2025). Profit margin: 12% (up from 9.2% in 3Q 2025). The increase in margin was driven by higher revenue. Over the last 3 years on average, earnings per share has fallen by 27% per year but the company’s share price has only fallen by 2% per year, which means it has not declined as severely as earnings.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
