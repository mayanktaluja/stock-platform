    {
      "id": "7ddb0f3e-8231-40ee-9057-b8c9f054a6a4",
      "type": "brief",
      "date": "2026-02-18T11:43:36.000Z",
      "title": "Dividend of ₹5.00 announced",
      "body": "Shareholders will receive a dividend of ₹5.00. Ex-date: 20th February 2026 Payment date: 16th March 2026 Dividend yield will be 4.5%, which is higher than the industry average of 0.9%. Sustainability & Growth Dividend is well covered by both earnings (13% earnings payout ratio) and cash flows (21% cash payout ratio). The dividend has increased by an average of 7.2% per year over the past 10 years. However, payments have been volatile during that time. Earnings per share has grown by 4.2% over the last 5 years. Unless this trend reverses, it should provide support to the dividend and adequate earnings cover.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "d53896cc-6d7d-4e1d-a74b-de48dd07196c",
      "type": "brief",
      "date": "2026-02-16T11:29:01.000Z",
      "title": "Third quarter 2026 earnings released: EPS: ₹5.11 (vs ₹6.57 in 3Q 2025)",
      "body": "Third quarter 2026 results: EPS: ₹5.11 (down from ₹6.57 in 3Q 2025). Revenue: ₹4.32b (up 4.8% from 3Q 2025). Net income: ₹163.5m (down 22% from 3Q 2025). Profit margin: 3.8% (down from 5.1% in 3Q 2025). The decrease in margin was driven by higher expenses. Over the last 3 years on average, earnings per share has increased by 99% per year but the company’s share price has only increased by 10% per year, which means it is significantly lagging earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "67d54408-9fcf-4adb-8848-5bc1ab4c7d16",
      "type": "event",
      "date": "2026-02-14T17:44:00.000Z",
      "title": "Kse Limited Declares First Interim Dividend for the Financial Year 2025-26, Payable on or Before 16 March 2026",
      "body": "Kse Limited announced at the board meeting held on February 14, 2026, Declared 1st interim dividend of INR 5 per equity share having face value of INR 1/- each for the financial year 2025-26. The Interim Dividend would be paid to members whose names appear on the Register of Members as on the Record Date i.e. 21.02.2026. The dividend shall be paid on or before 16th March 2026.",
      "keyDevTypeId": "46",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
