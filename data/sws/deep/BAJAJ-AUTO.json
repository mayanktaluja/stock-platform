    {
      "id": "00ce9133-aa7a-4539-955f-d955c714c182",
      "type": "event",
      "date": "2026-05-06T13:04:00.000Z",
      "title": "Bajaj Auto Limited (NSEI:BAJAJ-AUTO) announces an Equity Buyback for 4,694,000 shares, representing 1.68% for INR 56,330 million.",
      "body": "Bajaj Auto Limited (NSEI:BAJAJ-AUTO) announces a share repurchase program. Under the program, the company will repurchase up to 4,694,000 shares, representing 1.68% of its share capital, for INR 56,330 million. The offer price will be INR 12,000 per share. The purpose of the program is to return surplus cash to shareholders in an effective and efficient manner, which in turn will improve its earnings per share and return on equity. The program will be funded from the free reserves and/or such other source as may be permitted by the Buyback Regulations or the Act. The Buyback is subject to approval of the shareholders by means of a special resolution through a postal ballot. As of March 31, 2026, the company had 279,497,838 shares in outstanding.",
      "keyDevTypeId": "232",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
