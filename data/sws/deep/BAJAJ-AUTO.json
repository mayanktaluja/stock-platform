  "news": [
    {
      "id": "462abff8-f5b9-4777-a030-1c1bb26d34d9",
      "type": "brief",
      "date": "2026-05-07T18:01:08.000Z",
      "title": "Full year 2026 earnings: EPS and revenues exceed analyst expectations",
      "body": "Full year 2026 results: EPS: ₹385 (up from ₹262 in FY 2025). Revenue: ₹650.9b (up 26% from FY 2025). Net income: ₹107.4b (up 47% from FY 2025). Profit margin: 17% (up from 14% in FY 2025). The increase in margin was driven by higher revenue. Revenue exceeded analyst estimates by 4.7%. Earnings per share (EPS) also surpassed analyst estimates by 12%. Revenue is forecast to grow 7.6% p.a. on average during the next 3 years, compared to a 8.2% growth forecast for the Auto industry in India. Over the last 3 years on average, earnings per share has increased by 14% per year but the company’s share price has increased by 33% per year, which means it is tracking significantly ahead of earnings growth.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
