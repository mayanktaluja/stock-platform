    },
    {
      "id": "824cc8d5-906c-4f8d-bbfe-c39cf77def81",
      "type": "brief",
      "date": "2026-04-09T11:53:38.000Z",
      "title": "Price target decreased by 7.6% to ₹940",
      "body": "Down from ₹1,018, the current price target is an average from 10 analysts. New target price is 31% above last closing price of ₹720. Stock is down 14% over the past year. The company is forecast to post earnings per share of ₹33.20 for next year compared to ₹29.68 last year.",
      "keyDevTypeId": null,
      "source_url": null,
      "raw_subtype": "BriefActivity"
    },
    {
      "id": "b831c68b-bce0-4c95-9981-c971af225b7f",
      "type": "narrative-update",
      "date": "2026-04-08T17:07:37.000Z",
      "title": "APLLTD: US Approvals And First Branded Launch Will Support Upside Potential",
      "body": "Analysts have trimmed their price target on Alembic Pharmaceuticals from ₹1,056.64 to ₹949.90, citing updated assumptions for the discount rate, revenue growth, profit margin and future P/E multiples. What's in the News Alembic received final USFDA approval for a supplemental Abbreviated New Drug Application for Paroxetine Extended Release Tablets, 12.5 mg, which are therapeutically equivalent to Paxil CR Tablets.",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/pharmaceuticals-biotech/nse-aplltd/alembic-pharmaceuticals-shares/qkdv5nue-us-product-launches-and-india-execution-will-expand-reach-atn3/updates/12-analysts-have-trimmed-their-price-target-on-alembic-pharmace",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "4a8b3d3c-4c08-4802-af8e-8f78b1f85559",
      "type": "narrative-update",
      "date": "2026-03-25T09:07:42.000Z",
      "title": "APLLTD: Expanding US Branded And Generic Portfolio Will Support Long Term Upside",
      "body": "Analysts have maintained Alembic Pharmaceuticals' price target at ₹845, reflecting only minor tweaks to revenue growth, profit margin and future P/E assumptions, rather than a shift in their overall view of the stock. What's in the News Alembic Therapeutics LLC, a step down wholly owned subsidiary, reported its first prescription based sale in the US after the commercial launch of Pivya (pivmecillinam) tablets for uncomplicated urinary tract infections in adult women.",
      "keyDevTypeId": null,
      "source_url": "https://simplywall.st/community/narratives/in/pharmaceuticals-biotech/nse-aplltd/alembic-pharmaceuticals-shares/w8sw8s6g-regulatory-scrutiny-and-supply-issues-will-squeeze-pharma-prospects/updates/5-analysts-have-maintained-alembic-pharmaceuticals-price-targ",
      "raw_subtype": "narrative-update"
    },
    {
      "id": "7c32aaad-be62-4657-b041-2df2e065561d",
