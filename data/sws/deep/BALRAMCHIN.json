    {
      "id": "fe72173f-4129-475c-afb2-5d88b8266abd",
      "type": "narrative-update",
      "date": "2026-03-24T04:25:06.000Z",
      "title": "BALRAMCHIN: Early PLA Orders Will Support Upcoming Capacity Ramp-Up",
