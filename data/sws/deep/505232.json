    {
      "id": "996734a4-6c88-448a-8240-2d58215238d8",
      "type": "event",
      "date": "2026-05-30T10:06:00.000Z",
      "title": "Veljan Denison Limited Recommends Dividend for the Financial Year Ended on March 31, 2026",
      "body": "Veljan Denison Limited at its board meeting held on May 30, 2026, recommended a dividend of INR 8.50 per equity share (i.e. 85%) of INR 10 each on the present issued capital of INR 45.0 million for the financial year ended on March 31, 2026 subject to the approval of the members at the upcoming Annual General Meeting. Upon approval by the shareholders, the said dividend shall be paid/dispatched within the prescribed statutory period from the date of declaration at the Annual General Meeting.",
      "keyDevTypeId": "45",
      "source_url": null,
      "raw_subtype": "EventActivity"
    },
    {
      "id": "f5abdf96-c135-4305-a053-ea6146723c53",
      "type": "event",
      "date": "2026-05-30T10:06:00.000Z",
      "title": "Veljan Denison Limited Approves Change in Designation from Non-Executive Director to Chairman (Non-Executive), Effective May 30, 2026",
      "body": "Veljan Denison Limited at its board meeting held on May 30, 2026, approved change in designation from Non- Executive Director to Chairman (Non-Executive) of the Company. Mr.V.Gangadhar Srinivas, (DIN.00181826), a Non- Executive Non-Independent of the Company is a qualified engineer and completed his Master's Degree in Fluid Power Systems at the University of Bath, UK. Mr. V.G. Srinivas began his career at Hagglunds Denison India Ltd. as a production manager. He has been the vital part of the Company for its growth and diversification to many other countries. Over the course of his 20+ years of service, he went on to become Executive Director, and then Managing Director of the company for a period from 2004-2007.",
      "keyDevTypeId": "16",
      "source_url": null,
      "raw_subtype": "EventActivity"
