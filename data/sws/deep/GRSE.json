    {
      "id": "2e0db407-ded9-425d-a90a-6bf254cbbac1",
      "type": "narrative-update",
      "date": "2026-04-06T13:07:56.000Z",
      "title": "GRSE: National Shipbuilding Consortium And Naval MoUs Will Support Bullish Outlook",
