{
  "version": 2,
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/(.*)",       "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{gated/**,data/macroRegime.json,data/sws/picks-latest.json,data/sws/sws-scored-universe.json,data/sws/v3-universe-stats.json,data/sws/last-refresh.json,data/sws/deep/**,data/sws/_sanity/**,data/catalysts/**,data/coverage/**,data/nse-index-constituents.json,governance.json,fundamentals.json,fundamentalsHistory.json,services/swsDal/**,db/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/warm-caches",
      "schedule": "15 3 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-surveillance",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "15 14 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-earnings",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/snapshot-track-record",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/resolve-forward-returns",
      "schedule": "0 5 * * *"
    }
  ]
}
