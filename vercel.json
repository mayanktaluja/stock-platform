{
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/(.*)",       "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{gated/**,data/*.json,data/sws*/*.json,data/sws/deep.tar.gz,data/sws/_sanity/**,data/catalysts/**,data/coverage/**,services/swsDal/**,db/**,fundamentals.json,fundamentalsHistory.json,governance.json}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/warm-caches",
      "schedule": "15 3 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-surveillance",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "15 14 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-earnings",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/snapshot-track-record",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/resolve-forward-returns",
      "schedule": "0 5 * * *"
    }
  ]
}
