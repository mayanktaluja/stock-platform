{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/prepare-public-assets.mjs",
  "regions": ["bom1"],
  "headers": [
    {
      "source": "/assets/gated/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/(.*)",       "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{gated/**,data/*.json,data/sws*/*.{json,tar.gz},data/sws/alerts/*.json,data/{catalysts,coverage,track-record,risk-lab,strategy,sectorOutlook,nse-fo,disclosures}/**,services/swsDal/**,db/**,fundamentals*.json,*ance.json}",
      "excludeFiles": "{test/**,test-results/**,.git*/**,.claude/**,.Codex/**,.vercel/**,.sentiment-cache.json,.paper-trades.json,playwright.config.mjs,data/sws*/deep*/**,data/sws/chronos-*/**,data/{sectorOutlook/classified-news/**,nse-fo/history/**,strategy/history/**}}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "15 14 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-fo-oi",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/snapshot-track-record",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/resolve-forward-returns",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sws-input-alerts/send",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/sws-input-alerts/heartbeat",
      "schedule": "0 12 * * *"
    }
  ]
}
