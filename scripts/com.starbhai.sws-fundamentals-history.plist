<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.starbhai.sws-fundamentals-history</string>

    <!--
      Dedicated job for fundamentalsHistory.json (Yahoo historical financials
      feeding the Earnings Watch trajectory predictor). SEPARATE from
      com.starbhai.sws-nightly by design — it's a ~30-min budget-capped Yahoo
      job that must not run inside the twice-daily SWS scrape.

      caffeinate -dimsu keeps the machine awake for the duration, same as the
      sws-nightly job.

      Install: cp this file to ~/Library/LaunchAgents/ then run
      scripts/sws-resume-nightly.sh (or launchctl load -w it directly).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-dimsu</string>
        <string>/bin/bash</string>
        <string>/Users/mayanktaluja/code/stock-platform/scripts/sws-fundamentals-history-nightly.sh</string>
    </array>

    <!--
      Fire once daily at 04:00 IST (Mac local time is IST) — offset from the
      sws-nightly fires (02:00 + 16:30 IST) so the two jobs don't contend for
      CPU/network. The refresh is budget-capped per run, so a daily cadence
      progressively catches the universe up without blowing Yahoo's
      ~2000/day soft ceiling.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/mayanktaluja/code/stock-platform</string>

    <key>StandardOutPath</key>
    <string>/Users/mayanktaluja/code/stock-platform/data/sws/launchd-fh-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mayanktaluja/code/stock-platform/data/sws/launchd-fh-stderr.log</string>

    <!-- launchd starts with a minimal PATH; explicit values for tools the script needs. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/mayanktaluja</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <!-- Don't run on launchctl load; only at the scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- If a scheduled fire is missed (Mac asleep at 04:00), run on next wake. -->
    <key>StartCalendarIntervalCatchUp</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
