<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.starbhai.sws-nightly</string>

    <!--
      caffeinate holds display / idle / disk / system-sleep assertions for the
      run. It does NOT, and cannot, guarantee an uninterrupted run.

      This comment used to claim it "prevents sleep mid-scrape regardless of lid
      state". That is false, and believing it is what produced the 2026-08-08
      outage: the nightly ran on battery, the host cycled ~20s DarkWake against
      ~14.5min Deep Idle all night, the body did not start for 11h46m, 2 of 3
      scrape shards died on a wall-clock browser-launch timeout while frozen,
      and production served 55h-old data.

      What man caffeinate actually says on this host:
        -s  "valid only when system is running on AC power"  → useless on battery
        -u  without -t defaults to a 5-SECOND assertion
        -t  "is not used when an utility is invoked with this command"
      Because this plist invokes a utility (/bin/bash), -t cannot be supplied, so
      -u can never be more than 5 seconds. It has been dropped: -dimsu → -dims.
      The 08-08 pmset log shows it expiring exactly as documented
      ("TimedOut UserIsActive … 00:00:05") 18 seconds before the machine slept.

      Also true and unchanged: on Apple Silicon with the lid CLOSED and no
      external display the system can sleep even on AC.

      The real defence now lives in sws-nightly-isolated.sh, which waits for AC
      before starting (SWS_NIGHTLY_AC_WAIT) and bounds the run so it can never
      suppress the next 00:30 slot (SWS_NIGHTLY_DEADLINE_SEC).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-dims</string>
        <string>/bin/bash</string>
        <string>/Users/mayanktaluja/code/stock-platform/scripts/sws-nightly-isolated.sh</string>
    </array>

    <!--
      Fire once daily at 00:30 IST (Mac local time), after SWS's rolling
      India updates have settled.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mayanktaluja/code/stock-platform</string>

    <key>StandardOutPath</key>
    <string>/Users/mayanktaluja/code/stock-platform/data/sws/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mayanktaluja/code/stock-platform/data/sws/launchd-stderr.log</string>

    <!-- launchd starts with a minimal PATH; explicit values for tools the script needs. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/mayanktaluja</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <!-- Mirror scrape progress to Neon via the dual-write DAL. -->
        <key>SWS_DB_DUAL_WRITE</key>
        <string>1</string>
        <!-- Proceed even on battery — the ship-to-prod run must not silently no-op when unplugged. -->
        <key>SWS_NIGHTLY_SKIP_BATTERY</key>
        <string>1</string>
        <!-- Run git mutation/publish from an owned clean worktree, not the dev checkout. -->
        <key>SWS_NIGHTLY_PRIMARY_REPO</key>
        <string>/Users/mayanktaluja/code/stock-platform</string>
        <key>SWS_NIGHTLY_WORKTREE_DIR</key>
        <string>/Users/mayanktaluja/.Codex/worktrees/stock-platform-sws-nightly</string>
        <key>SWS_NIGHTLY_BASE_BRANCH</key>
        <string>sws-nightly-isolated-base</string>
    </dict>

    <!-- Don't run on launchctl load; only at scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <!--
      If the scheduled fire is missed (e.g., Mac was off at 00:30), run on
      next wake. We do want this for robustness — a late post-close scrape is
      still better than carrying yesterday's data.
    -->
    <key>StartCalendarIntervalCatchUp</key>
    <true/>

    <!-- Keep stale runs from accumulating; if it overruns the next 24 hr cycle, kill. -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
