<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.starbhai.sws-nightly</string>

    <!--
      Wrap the whole run in caffeinate -dimsu so display, idle, system idle,
      and user idle assertions are all set for the duration. This prevents
      sleep mid-scrape regardless of lid state (note: on Apple Silicon with
      lid CLOSED and no external display, the system can still sleep — keep
      lid open OR connect external display for fully reliable closed-lid runs).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-dimsu</string>
        <string>/bin/bash</string>
        <string>/Users/mayanktaluja/code/stock-platform/scripts/sws-nightly-isolated.sh</string>
    </array>

    <!--
      Fire once daily at 16:30 IST (Mac local time), 60 min after NSE close.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>16</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mayanktaluja/code/stock-platform</string>

    <key>StandardOutPath</key>
    <string>/Users/mayanktaluja/code/stock-platform/data/sws/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mayanktaluja/code/stock-platform/data/sws/launchd-stderr.log</string>

    <!-- launchd starts with a minimal PATH; explicit values for tools the script needs. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/mayanktaluja</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <!-- Mirror scrape progress to Neon via the dual-write DAL. -->
        <key>SWS_DB_DUAL_WRITE</key>
        <string>1</string>
        <!-- Proceed even on battery — the ship-to-prod run must not silently no-op when unplugged. -->
        <key>SWS_NIGHTLY_SKIP_BATTERY</key>
        <string>1</string>
        <!-- Run git mutation/publish from an owned clean worktree, not the dev checkout. -->
        <key>SWS_NIGHTLY_PRIMARY_REPO</key>
        <string>/Users/mayanktaluja/code/stock-platform</string>
        <key>SWS_NIGHTLY_WORKTREE_DIR</key>
        <string>/Users/mayanktaluja/.Codex/worktrees/stock-platform-sws-nightly</string>
        <key>SWS_NIGHTLY_BASE_BRANCH</key>
        <string>sws-nightly-isolated-base</string>
    </dict>

    <!-- Don't run on launchctl load; only at scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <!--
      If the scheduled fire is missed (e.g., Mac was off at 16:30), run on
      next wake. We do want this for robustness — a late post-close scrape is
      still better than carrying yesterday's data.
    -->
    <key>StartCalendarIntervalCatchUp</key>
    <true/>

    <!-- Keep stale runs from accumulating; if it overruns the next 24 hr cycle, kill. -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
